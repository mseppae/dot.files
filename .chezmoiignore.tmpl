# chezmoi-managed files to skip
.config/nvim/lazy-lock.json

# Repo meta files — not deployed to home directory
README.md
Dockerfile
CLAUDE.md
AGENTS.md
BOOTSTRAP_MODERNIZATION_PLAN.md

# Shell: Omarchy keeps its bash setup; zsh everywhere else
{{ if and (eq .chezmoi.os "linux") (eq (index .chezmoi.osRelease "id") "omarchy") }}
.zshenv
.config/zsh
.config/zsh/**
{{ else }}
.bashrc
{{ end }}

# macOS LaunchAgents — macOS only
{{ if ne .chezmoi.os "darwin" }}
Library
{{ end }}

# systemd user services — Linux only
{{ if ne .chezmoi.os "linux" }}
.config/systemd
{{ end }}

# Tiling WM configs — plain Arch Linux only (exclude on macOS, Bazzite/GNOME,
# and Omarchy, which manages its own Hyprland setup)
{{ if or (ne .chezmoi.os "linux") (eq (index .chezmoi.osRelease "id") "bazzite") (eq (index .chezmoi.osRelease "id") "omarchy") }}
.config/hypr
.config/waybar
.config/rofi
.config/i3
.config/dunst
.config/greenclip.toml
.config/picom.conf
.Xresources
.xprofile
Wallpapers
.config/scripts
{{ end }}

# GNOME configs — Bazzite only (exclude on macOS and Arch Linux)
{{ if or (ne .chezmoi.os "linux") (ne (index .chezmoi.osRelease "id") "bazzite") }}
.config/gtk-3.0
.config/gtk-4.0
.config/gnome-shell
{{ end }}

# KDE configs — Bazzite only (exclude on macOS and Arch Linux)
{{ if or (ne .chezmoi.os "linux") (ne (index .chezmoi.osRelease "id") "bazzite") }}
.config/kxkbrc
.config/konsolerc
.local/share/konsole
{{ end }}
