{{- $installCodex := promptBoolOnce . "installCodex" "Install OpenAI Codex CLI and desktop app on this machine?" false -}}
{{- $installClaude := promptBoolOnce . "installClaude" "Install Claude Code CLI and desktop app on this machine?" true -}}
{{- $installPi := promptBoolOnce . "installPi" "Install the Pi coding agent CLI on this machine?" false -}}
{{- $installBlender := promptBoolOnce . "installBlender" "Install Blender on this machine?" false -}}
{{- $installHerdr := promptBoolOnce . "installHerdr" "Install the herdr agent multiplexer on this machine?" false -}}
{{- $herdrClaudeIntegration := false -}}
{{- if and $installHerdr $installClaude -}}
{{-   $herdrClaudeIntegration = promptBoolOnce . "herdrClaudeIntegration" "Install the herdr integration for Claude Code?" true -}}
{{- end -}}
{{- $herdrNvimPlugin := false -}}
{{- if $installHerdr -}}
{{-   $herdrNvimPlugin = promptBoolOnce . "herdrNvimPlugin" "Build and link the herdr-nvim plugin from source?" true -}}
{{- end -}}
{{- $herdrNavigator := false -}}
{{- if $installHerdr -}}
{{-   $herdrNavigator = promptBoolOnce . "herdrNavigator" "Build and link the herdr-navigator plugin from source?" true -}}
{{- end -}}

{{ if stat (joinPath .chezmoi.homeDir "Development/dot.files") -}}
sourceDir = "{{ .chezmoi.homeDir }}/Development/dot.files"
{{ else -}}
sourceDir = "{{ .chezmoi.homeDir }}/development/dot.files"
{{ end -}}

[data]
installCodex = {{ $installCodex }}
installClaude = {{ $installClaude }}
installPi = {{ $installPi }}
installBlender = {{ $installBlender }}
installHerdr = {{ $installHerdr }}
{{- if and $installHerdr $installClaude }}
herdrClaudeIntegration = {{ $herdrClaudeIntegration }}
{{- end }}
{{- if $installHerdr }}
herdrNvimPlugin = {{ $herdrNvimPlugin }}
herdrNavigator = {{ $herdrNavigator }}
{{- end }}
