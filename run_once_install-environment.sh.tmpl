#!/bin/bash
{{- $installClaude := true }}
{{- if hasKey . "installClaude" }}{{ $installClaude = .installClaude }}{{ end }}
# chezmoi runs each distinct rendered version once after a successful apply.
# Bootstrap missing tools. The OS package manager provides zsh and mise; mise
# installs the command-line tools declared in ~/.config/mise/conf.d.

set -euo pipefail

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

detect_platform() {
  OS="$(uname -s)"
  PLATFORM="unsupported"
  IS_OMARCHY=false
  case "$OS" in
    Darwin) PLATFORM="macos" ;;
    Linux)
      if [[ -f /etc/os-release ]]; then
        local os_id variant_id
        os_id="$(. /etc/os-release && echo "${ID:-unknown}")"
        variant_id="$(. /etc/os-release && echo "${VARIANT_ID:-}")"
        case "$os_id" in
          arch) PLATFORM="arch" ;;
          # Omarchy is Arch-based and uses the same pacman packages.
          omarchy) PLATFORM="arch"; IS_OMARCHY=true ;;
          bazzite) PLATFORM="bazzite" ;;
          *)
            case "$variant_id" in
              bazzite|bazzite-*) PLATFORM="bazzite" ;;
            esac
            ;;
        esac
      fi
      ;;
  esac
  if [[ "$PLATFORM" == "unsupported" ]]; then
    echo "Unsupported platform: $OS. Bootstrap supports macOS, Bazzite, and Arch Linux." >&2
    exit 1
  fi
}

install_brew() {
  local brew_path
  if [[ "$PLATFORM" == "bazzite" ]]; then
    brew_path="/home/linuxbrew/.linuxbrew/bin/brew"
  elif [[ "$(uname -m)" == "arm64" ]]; then
    brew_path="/opt/homebrew/bin/brew"
  else
    brew_path="/usr/local/bin/brew"
  fi

  if [[ -x "$brew_path" ]]; then
    eval "$("$brew_path" shellenv)"
  fi
  if ! command_exists brew; then
    echo "Installing Homebrew for $PLATFORM..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$("$brew_path" shellenv)"
  fi
}

install_brew_apps() {
  local app
  local apps=(zsh mise)
  if [[ "$PLATFORM" == "bazzite" ]]; then
    apps+=(openssl@3 readline libyaml libffi)
  fi
  for app in "${apps[@]}"; do
    # Formula names need not be commands (ripgrep provides rg; libraries none).
    if ! brew list --formula "$app" >/dev/null 2>&1; then
      echo "Installing $app via Homebrew..."
      brew install "$app"
    fi
  done
}

install_arch_apps() {
  # Use existing sync databases; never perform a partial upgrade with pacman -Sy.
  local apps=(ghostty)
  # Omarchy keeps bash as the login shell.
  if [[ "$IS_OMARCHY" != true ]]; then
    apps+=(zsh)
  fi
  # Omarchy ships mise-bin, which provides and conflicts with the mise package.
  if ! command_exists mise; then
    apps+=(mise)
  fi
  sudo pacman -S --needed "${apps[@]}"
}

install_ghostty() {
  if command_exists ghostty || [[ "$PLATFORM" == "arch" ]]; then
    return
  fi
  if [[ "$PLATFORM" == "bazzite" ]]; then
    echo "Installing Ghostty via rpm-ostree (requires reboot to take effect)..."
    local version_id
    version_id="$(. /etc/os-release && echo "$VERSION_ID")"
    curl -fsSL "https://copr.fedorainfracloud.org/coprs/scottames/ghostty/repo/fedora-${version_id}/scottames-ghostty-fedora-${version_id}.repo" \
      | sudo tee /etc/yum.repos.d/_copr_scottames-ghostty.repo > /dev/null
    rpm-ostree refresh-md
    rpm-ostree install --idempotent -y ghostty
  elif ! brew list --cask ghostty >/dev/null 2>&1; then
    echo "Installing Ghostty via Homebrew Cask..."
    brew install --cask ghostty
  fi
}

set_default_shell() {
  if [[ "$IS_OMARCHY" == true ]]; then
    return
  fi
  local zsh_path
  zsh_path="$(command -v zsh)"
  if [[ "${SHELL:-}" != "$zsh_path" ]]; then
    echo "Setting zsh as default shell..."
    if ! grep -qxF "$zsh_path" /etc/shells; then
      echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    fi
    if [[ "$PLATFORM" == "macos" ]]; then
      chsh -s "$zsh_path"
    elif command_exists usermod; then
      sudo usermod --shell "$zsh_path" "$(whoami)"
    else
      sudo chsh -s "$zsh_path" "$(whoami)"
    fi
    echo "Default shell set to $zsh_path (takes effect on next login)."
  fi
}

install_mise_tools() {
  echo "Installing mise tools..."
  mise install
  # Expose mise-managed tools (including bob) to the rest of this script.
  export PATH="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims:$PATH"
}

install_neovim() {
  echo "Installing Neovim nightly via bob..."
  chmod -f u+w "$HOME/.local/share/bob/nvim-bin/nvim" 2>/dev/null || true
  bob install nightly
  bob use nightly
}

install_codex_desktop() (
  # OpenAI now distributes the desktop app with Codex as ChatGPT.
  case "$PLATFORM" in
    macos)
      if [[ -d /Applications/ChatGPT.app || -d "$HOME/Applications/ChatGPT.app" ]] \
        || brew list --cask chatgpt >/dev/null 2>&1; then
        return
      fi
      echo "Installing the desktop app with Codex via Homebrew Cask..."
      brew install --cask chatgpt
      ;;
    arch)
      if pacman -Q chatgpt >/dev/null 2>&1; then
        return
      fi
      if [[ "$IS_OMARCHY" == true ]]; then
        # Omarchy packages the app; it conflicts with OpenAI's chatgpt-bin.
        echo "Installing the desktop app with Codex from the Omarchy repository..."
        omarchy-pkg-add openai-codex-desktop
        return
      fi
      local installer_dir
      installer_dir="$(mktemp -d)"
      trap 'rm -rf "$installer_dir"' EXIT
      echo "Installing the desktop app with Codex (adds OpenAI's repository and upgrades Arch)..."
      curl -fsSL https://persistent.oaistatic.com/codex-app-prod/linux/install-arch.sh \
        -o "$installer_dir/install-arch.sh"
      sudo bash "$installer_dir/install-arch.sh"
      ;;
    bazzite)
      if rpm -q chatgpt >/dev/null 2>&1; then
        return
      fi
      local rpm_arch
      case "$(uname -m)" in
        x86_64) rpm_arch=x86_64 ;;
        aarch64|arm64) rpm_arch=aarch64 ;;
        *) echo "Unsupported desktop app architecture: $(uname -m)" >&2; return 1 ;;
      esac
      echo "Installing the desktop app with Codex via rpm-ostree (requires reboot to take effect)..."
      rpm-ostree install --idempotent -y \
        "https://persistent.oaistatic.com/codex-app-prod/linux/rpm/latest/chatgpt.${rpm_arch}.rpm"
      ;;
  esac
)

install_claude_desktop() {
  case "$PLATFORM" in
    macos)
      if [[ -d /Applications/Claude.app || -d "$HOME/Applications/Claude.app" ]] \
        || brew list --cask claude >/dev/null 2>&1; then
        return
      fi
      echo "Installing Claude Desktop via Homebrew Cask..."
      brew install --cask claude
      ;;
    arch)
      if pacman -Q claude-desktop >/dev/null 2>&1; then
        return
      fi
      if [[ "$IS_OMARCHY" == true ]]; then
        echo "Installing Claude Desktop from the Omarchy repository..."
        omarchy-pkg-add claude-desktop
      else
        # Bootstrap does not require an AUR helper; the AUR has claude-desktop.
        echo "Claude Desktop is not in the official Arch repositories; see https://claude.com/download"
      fi
      ;;
    bazzite)
      # Anthropic publishes Linux builds as Debian packages only.
      echo "Claude Desktop has no Fedora package; see https://claude.com/download"
      ;;
  esac
}

install_claude() {
{{ if $installClaude }}
  # Claude Code is installed by mise (conf.d/cli.toml).
  install_claude_desktop
{{ else }}
  echo "Claude installation disabled for this machine."
{{ end }}
}

install_codex() {
{{ if (index . "installCodex" | default false) }}
  # The Codex CLI is installed by mise (conf.d/cli.toml).
  install_codex_desktop
{{ else }}
  echo "OpenAI Codex installation disabled for this machine."
{{ end }}
}

detect_platform
# Native installers use this directory; expose tools in this apply as well.
export PATH="$HOME/.local/bin:$PATH"
case "$PLATFORM" in
  macos|bazzite)
    install_brew
    install_brew_apps
    ;;
  arch) install_arch_apps ;;
esac
install_ghostty
set_default_shell
install_mise_tools
install_neovim
install_claude
install_codex
