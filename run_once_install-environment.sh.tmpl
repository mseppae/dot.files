#!/bin/bash
{{- $installClaude := true }}
{{- if hasKey . "installClaude" }}{{ $installClaude = .installClaude }}{{ end }}
# chezmoi runs each distinct rendered version once after a successful apply.
# Bootstrap missing tools. The OS package manager provides zsh and mise; mise
# installs the command-line tools declared in ~/.config/mise/conf.d.

set -euo pipefail

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

# OpenAI's Linux repositories for the desktop app with Codex. The key is trusted
# only if it matches this fingerprint, pinned here rather than taken from the CDN.
OPENAI_REPO_URL="https://persistent.oaistatic.com/codex-app-prod/linux"
OPENAI_KEY_FINGERPRINT="3BFA0E4AE8B8CC16A2D9BA684A3B4A566C4660E4"

download() {
  curl --proto '=https' --tlsv1.2 -fsSL "$1" -o "$2"
}

sha256() {
  if command_exists sha256sum; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# Download an installer script and run it only after interactive confirmation,
# never piping the network straight into a shell.
run_reviewed_script() {
  local url="$1" script answer
  script="$(mktemp)"
  download "$url" "$script"
  echo "Downloaded $url"
  echo "  sha256: $(sha256 "$script")"
  if ! { true </dev/tty; } 2>/dev/null; then
    echo "No terminal to confirm on; review and run it yourself: $url" >&2
    rm -f "$script"
    return 1
  fi
  while true; do
    read -r -p "Run it? [y]es / [v]iew / [N]o: " answer </dev/tty
    case "$answer" in
      v|V) "${PAGER:-less}" "$script" </dev/tty ;;
      y|Y) break ;;
      *) rm -f "$script"; return 1 ;;
    esac
  done
  /bin/bash "$script"
  rm -f "$script"
}

# Fetch OpenAI's repository signing key to $1, failing unless its primary key
# fingerprint is exactly the pinned one.
fetch_openai_key() {
  local key="$1" gpg_home fingerprints
  gpg_home="$(mktemp -d)"
  download "$OPENAI_REPO_URL/repository-signing-key.gpg" "$key"
  fingerprints="$(gpg --homedir "$gpg_home" --batch --show-keys --with-colons "$key" 2>/dev/null \
    | awk -F: '$1 == "pub" { primary=1 } $1 == "sub" { primary=0 } $1 == "fpr" && primary { print $10; primary=0 }')"
  rm -rf "$gpg_home"
  if [[ "$fingerprints" != "$OPENAI_KEY_FINGERPRINT" ]]; then
    echo "OpenAI signing key fingerprint mismatch; refusing to trust it." >&2
    return 1
  fi
}

detect_platform() {
  OS="$(uname -s)"
  PLATFORM="unsupported"
  IS_OMARCHY=false
  case "$OS" in
    Darwin) PLATFORM="macos" ;;
    Linux)
      if [[ -f /etc/os-release ]]; then
        local os_id variant_id
        os_id="$(. /etc/os-release && echo "${ID:-unknown}")"
        variant_id="$(. /etc/os-release && echo "${VARIANT_ID:-}")"
        case "$os_id" in
          arch) PLATFORM="arch" ;;
          # Omarchy is Arch-based and uses the same pacman packages.
          omarchy) PLATFORM="arch"; IS_OMARCHY=true ;;
          bazzite) PLATFORM="bazzite" ;;
          *)
            case "$variant_id" in
              bazzite|bazzite-*) PLATFORM="bazzite" ;;
            esac
            ;;
        esac
      fi
      ;;
  esac
  if [[ "$PLATFORM" == "unsupported" ]]; then
    echo "Unsupported platform: $OS. Bootstrap supports macOS, Bazzite, and Arch Linux." >&2
    exit 1
  fi
}

install_brew() {
  local brew_path
  if [[ "$PLATFORM" == "bazzite" ]]; then
    brew_path="/home/linuxbrew/.linuxbrew/bin/brew"
  elif [[ "$(uname -m)" == "arm64" ]]; then
    brew_path="/opt/homebrew/bin/brew"
  else
    brew_path="/usr/local/bin/brew"
  fi

  if [[ -x "$brew_path" ]]; then
    eval "$("$brew_path" shellenv)"
  fi
  if ! command_exists brew; then
    echo "Installing Homebrew for $PLATFORM..."
    run_reviewed_script https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
    eval "$("$brew_path" shellenv)"
  fi
}

install_brew_apps() {
  local app
  local apps=(zsh mise)
  if [[ "$PLATFORM" == "bazzite" ]]; then
    apps+=(openssl@3 readline libyaml libffi)
  fi
  for app in "${apps[@]}"; do
    # Formula names need not be commands (ripgrep provides rg; libraries none).
    if ! brew list --formula "$app" >/dev/null 2>&1; then
      echo "Installing $app via Homebrew..."
      brew install "$app"
    fi
  done
}

install_arch_apps() {
  # Use existing sync databases; never perform a partial upgrade with pacman -Sy.
  local apps=(ghostty)
  # Omarchy keeps bash as the login shell.
  if [[ "$IS_OMARCHY" != true ]]; then
    apps+=(zsh)
  fi
  # Omarchy ships mise-bin, which provides and conflicts with the mise package.
  if ! command_exists mise; then
    apps+=(mise)
  fi
  sudo pacman -S --needed "${apps[@]}"
}

install_ghostty() {
  if command_exists ghostty || [[ "$PLATFORM" == "arch" ]]; then
    return
  fi
  if [[ "$PLATFORM" == "bazzite" ]]; then
    echo "Installing Ghostty via rpm-ostree (requires reboot to take effect)..."
    local version_id repo_file
    version_id="$(. /etc/os-release && echo "$VERSION_ID")"
    if [[ ! "$version_id" =~ ^[0-9]+$ ]]; then
      echo "Unexpected Fedora VERSION_ID '$version_id'; skipping Ghostty." >&2
      return 1
    fi
    repo_file="$(mktemp)"
    download "https://copr.fedorainfracloud.org/coprs/scottames/ghostty/repo/fedora-${version_id}/scottames-ghostty-fedora-${version_id}.repo" \
      "$repo_file"
    # Only install the repository if it enforces package signatures.
    if ! grep -qx 'gpgcheck=1' "$repo_file"; then
      echo "Ghostty COPR repository does not set gpgcheck=1; refusing to add it." >&2
      rm -f "$repo_file"
      return 1
    fi
    sudo install -m 0644 "$repo_file" /etc/yum.repos.d/_copr_scottames-ghostty.repo
    rm -f "$repo_file"
    rpm-ostree refresh-md
    rpm-ostree install --idempotent -y ghostty
  elif ! brew list --cask ghostty >/dev/null 2>&1; then
    echo "Installing Ghostty via Homebrew Cask..."
    brew install --cask ghostty
  fi
}

set_default_shell() {
  if [[ "$IS_OMARCHY" == true ]]; then
    return
  fi
  local zsh_path
  zsh_path="$(command -v zsh)"
  if [[ "${SHELL:-}" != "$zsh_path" ]]; then
    echo "Setting zsh as default shell..."
    if ! grep -qxF "$zsh_path" /etc/shells; then
      echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    fi
    if [[ "$PLATFORM" == "macos" ]]; then
      chsh -s "$zsh_path"
    elif command_exists usermod; then
      sudo usermod --shell "$zsh_path" "$(whoami)"
    else
      sudo chsh -s "$zsh_path" "$(whoami)"
    fi
    echo "Default shell set to $zsh_path (takes effect on next login)."
  fi
}

install_mise_tools() {
  echo "Installing mise tools..."
  mise install
  # Expose mise-managed tools (including bob) to the rest of this script.
  export PATH="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims:$PATH"
}

install_neovim() {
  echo "Installing Neovim nightly via bob..."
  chmod -f u+w "$HOME/.local/share/bob/nvim-bin/nvim" 2>/dev/null || true
  bob install nightly
  bob use nightly
}

install_codex_desktop() (
  # OpenAI now distributes the desktop app with Codex as ChatGPT.
  case "$PLATFORM" in
    macos)
      if [[ -d /Applications/ChatGPT.app || -d "$HOME/Applications/ChatGPT.app" ]] \
        || brew list --cask chatgpt >/dev/null 2>&1; then
        return
      fi
      echo "Installing the desktop app with Codex via Homebrew Cask..."
      brew install --cask chatgpt
      ;;
    arch)
      if pacman -Q chatgpt >/dev/null 2>&1 || pacman -Q chatgpt-bin >/dev/null 2>&1; then
        return
      fi
      if [[ "$IS_OMARCHY" == true ]]; then
        # Omarchy packages the app; it conflicts with OpenAI's chatgpt-bin.
        echo "Installing the desktop app with Codex from the Omarchy repository..."
        omarchy-pkg-add openai-codex-desktop
        return
      fi
      # Configure OpenAI's signed pacman repository directly instead of running
      # its installer as root; pacman then verifies packages against the key.
      local work_dir repo_conf=/etc/pacman.d/openai-chatgpt.conf
      work_dir="$(mktemp -d)"
      trap 'rm -rf "$work_dir"' EXIT
      echo "Installing the desktop app with Codex (adds OpenAI's repository and upgrades Arch)..."
      fetch_openai_key "$work_dir/openai.gpg"
      sudo pacman-key --add "$work_dir/openai.gpg"
      sudo pacman-key --lsign-key "$OPENAI_KEY_FINGERPRINT"
      if [[ ! -e "$repo_conf" ]]; then
        cat >"$work_dir/openai-chatgpt.conf" <<EOF
[openai-chatgpt]
SigLevel = Required DatabaseRequired TrustedOnly
Server = $OPENAI_REPO_URL/arch/\$arch
EOF
        sudo install -m 0644 "$work_dir/openai-chatgpt.conf" "$repo_conf"
      fi
      if ! grep -qxF "Include = $repo_conf" /etc/pacman.conf; then
        printf '\nInclude = %s\n' "$repo_conf" | sudo tee -a /etc/pacman.conf >/dev/null
      fi
      # A new repository needs a sync; always pair it with a full upgrade.
      sudo pacman -Syu --needed chatgpt-bin
      ;;
    bazzite)
      if rpm -q chatgpt >/dev/null 2>&1; then
        return
      fi
      case "$(uname -m)" in
        x86_64|aarch64) ;;
        *) echo "Unsupported desktop app architecture: $(uname -m)" >&2; return 1 ;;
      esac
      # Use OpenAI's signed dnf repository (not a bare RPM URL) so rpm-ostree
      # checks package and metadata signatures, and upgrades keep it current.
      local work_dir key_path=/etc/pki/rpm-gpg/RPM-GPG-KEY-openai-chatgpt
      work_dir="$(mktemp -d)"
      trap 'rm -rf "$work_dir"' EXIT
      fetch_openai_key "$work_dir/openai.gpg"
      sudo install -m 0644 "$work_dir/openai.gpg" "$key_path"
      cat >"$work_dir/openai-chatgpt.repo" <<EOF
[openai-chatgpt]
name=OpenAI ChatGPT
baseurl=$OPENAI_REPO_URL/rpm/\$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file://$key_path
EOF
      sudo install -m 0644 "$work_dir/openai-chatgpt.repo" /etc/yum.repos.d/openai-chatgpt.repo
      echo "Installing the desktop app with Codex via rpm-ostree (requires reboot to take effect)..."
      rpm-ostree refresh-md
      rpm-ostree install --idempotent -y chatgpt
      ;;
  esac
)

install_claude_desktop() {
  case "$PLATFORM" in
    macos)
      if [[ -d /Applications/Claude.app || -d "$HOME/Applications/Claude.app" ]] \
        || brew list --cask claude >/dev/null 2>&1; then
        return
      fi
      echo "Installing Claude Desktop via Homebrew Cask..."
      brew install --cask claude
      ;;
    arch)
      if pacman -Q claude-desktop >/dev/null 2>&1; then
        return
      fi
      if [[ "$IS_OMARCHY" == true ]]; then
        echo "Installing Claude Desktop from the Omarchy repository..."
        omarchy-pkg-add claude-desktop
      else
        # Bootstrap does not require an AUR helper; the AUR has claude-desktop.
        echo "Claude Desktop is not in the official Arch repositories; see https://claude.com/download"
      fi
      ;;
    bazzite)
      # Anthropic publishes Linux builds as Debian packages only.
      echo "Claude Desktop has no Fedora package; see https://claude.com/download"
      ;;
  esac
}

install_claude() {
{{ if $installClaude }}
  # Claude Code is installed by mise (conf.d/cli.toml).
  install_claude_desktop
{{ else }}
  echo "Claude installation disabled for this machine."
{{ end }}
}

install_codex() {
{{ if (index . "installCodex" | default false) }}
  # The Codex CLI is installed by mise (conf.d/cli.toml).
  install_codex_desktop
{{ else }}
  echo "OpenAI Codex installation disabled for this machine."
{{ end }}
}

detect_platform
# Native installers use this directory; expose tools in this apply as well.
# Appended so it cannot shadow system commands (matches dot_zshrc).
export PATH="$PATH:$HOME/.local/bin"
case "$PLATFORM" in
  macos|bazzite)
    install_brew
    install_brew_apps
    ;;
  arch) install_arch_apps ;;
esac
install_ghostty
set_default_shell
install_mise_tools
install_neovim
install_claude
install_codex
