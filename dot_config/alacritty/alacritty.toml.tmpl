[general]
{{- if and (eq .chezmoi.os "linux") (eq (index .chezmoi.osRelease "id") "omarchy") }}
# Omarchy defaults: theme colors (follow Omarchy theme switching), font, keybindings.
# Settings below override them.
import = ["/usr/share/omarchy/config/alacritty/alacritty.toml"]
{{- else }}
import = ["~/.cache/wal/colors-alacritty.toml"]
{{- end }}
live_config_reload = true

[window]
padding = { x = 5, y = 5 }
opacity = 0.9
blur = true
