# Ghostty config
{{- if and (eq .chezmoi.os "linux") (eq (index .chezmoi.osRelease "id") "omarchy") }}

# Omarchy defaults: theme colors (follow Omarchy theme switching), font, padding.
# Ghostty loads included files after this one; their keybinds do not overlap ours.
config-file = ?"/usr/share/omarchy/config/ghostty/config"
{{- end }}
# Ghostty only hosts herdr, which handles panes and tabs, so no split keys.

# Unbind ctrl+, (default: open_config) so it passes through to Neovim
keybind = ctrl+,=unbind
