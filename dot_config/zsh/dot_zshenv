#!/usr/bin/env zsh
# Inspured by https://thevaluable.dev/zsh-install-configure-mouseless/
# https://wiki.archlinux.org/title/XDG_Base_Directory
# XDG_DATA_HOME and XDG_CACHE_HOME keep their defaults (~/.local/share,
# ~/.cache): data under ~/.config gets synced and backed up with config.

# EDITOR/VISUAL and the FZF_* command overrides live in dot_config/shell/rc.sh,
# shared with bash (sourced from dot_config/zsh/dot_zshrc).

# HISTFILE/HISTSIZE/SAVEHIST are set in dot_zshrc: macOS /etc/zshrc runs
# after .zshenv and would override them.

# https://wiki.archlinux.org/title/Wayland#Qt
export QT_QPA_PLATFORM=wayland 
