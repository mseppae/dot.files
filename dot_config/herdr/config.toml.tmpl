# herdr config: https://herdr.dev/tui/docs/config-reference/
onboarding = false
{{- if (index . "herdrNvimPlugin" | default false) }}

# herdr-nvim plugin actions (built and linked by
# run_after_install-herdr-nvim-plugin.sh). Its README suggests prefix+e and
# prefix+o, but herdr already uses those (edit scrollback, notification target).
[[keys.command]]
key = "prefix+shift+e"
type = "plugin_action"
command = "chmarax.herdr-nvim.toggle"
description = "nvim sidebar"

[[keys.command]]
key = "prefix+f"
type = "plugin_action"
command = "chmarax.herdr-nvim.pick-file"
description = "open file from agent output"
{{- end }}
{{- if (index . "herdrNavigator" | default false) }}

# herdr-navigator (built and linked by run_after_install-herdr-navigator.sh).
# Its README's other keys clash with herdr defaults (prefix+l focuses the right
# pane, prefix+shift+t renames the tab).
[[keys.command]]
key = "prefix+t"
type = "plugin_action"
command = "herdr-navigator.open"
description = "jump to anything"
{{- end }}
{{- if (index . "herdrReviewr" | default false) }}

# herdr-reviewr (built and linked by run_after_install-herdr-reviewr.sh). Its
# README suggests cmd+r, which Linux lacks; prefix+r is herdr's resize mode.
[[keys.command]]
key = "prefix+d"
type = "plugin_action"
command = "persiyanov.reviewr.toggle"
description = "review agent diff"
{{- end }}
