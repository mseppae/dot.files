# Omarchy only: bash stays the login shell there (see .chezmoiignore.tmpl).
# Based on Omarchy's /etc/skel/.bashrc.

# Omarchy environment (OMARCHY_PATH + PATH), needed even for non-interactive shells
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

# If not running interactively, don't do anything else (leave this above the rc source)
[[ $- != *i* ]] && return

# All the default Omarchy aliases and functions (mise, starship, zoxide, fzf).
# Guarded: with OMARCHY_PATH unset this would source /default/bash/rc.
if [[ -n ${OMARCHY_PATH:-} && -r $OMARCHY_PATH/default/bash/rc ]]; then
  source "$OMARCHY_PATH/default/bash/rc"
fi

# Personal overrides, loaded after Omarchy's defaults.

# History: bash equivalents of dot_config/zsh/dot_zshrc's zsh history setopts.
HISTSIZE=10000                     # Maximum events kept in memory (zsh HISTSIZE).
HISTFILESIZE=10000                 # Maximum events kept in the history file (zsh SAVEHIST).
HISTCONTROL=ignoreboth:erasedups   # Skip space-prefixed & repeat commands, drop older duplicates
                                    # (HIST_IGNORE_SPACE, HIST_IGNORE_DUPS, HIST_IGNORE_ALL_DUPS,
                                    # HIST_SAVE_NO_DUPS).
shopt -s histappend                # Append to the history file instead of overwriting it.
shopt -s cmdhist                   # Save multi-line commands as one history entry.
shopt -s histverify                # Let you edit a history expansion before running it (HIST_VERIFY).

# Share history live between sessions (closest bash equivalent of zsh SHARE_HISTORY): write this
# session's new lines, then reload the merged file, before each prompt.
PROMPT_COMMAND="history -a; history -c; history -r${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

if [[ -f ${XDG_CONFIG_HOME:-$HOME/.config}/shell/rc.sh ]]; then
  . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/rc.sh"
fi
